<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <ApplicationTitle>Tetris Neo</ApplicationTitle>
        <Version>1.0.0</Version>
        <Authors>minigame-tech</Authors>
        <Company>minigame-tech</Company>
        <Product>Tetris Neo</Product>
        <Description>A modern, high-performance, arcade-quality Tetris clone built in C# and Raylib-cs.</Description>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Raylib-cs" Version="8.1.0" />
    </ItemGroup>

    <ItemGroup>
        <None Update="assets\**">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Update="src\background\**">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>

</Project>
